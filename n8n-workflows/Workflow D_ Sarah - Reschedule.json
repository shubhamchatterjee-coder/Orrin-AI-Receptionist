      "parameters": {
        "jsCode": "const body = $input.first().json.body || {};\nconst msg = body.message || {};\nconst call = (msg.toolCallList && msg.toolCallList[0]) || (msg.toolCalls && msg.toolCalls[0]) || null;\nlet args = call ? (call.arguments || (call.function && call.function.arguments) || {}) : body;\nif (typeof args === 'string') args = JSON.parse(args);\n\nconst date = String(args.date || '').trim();\nlet time = String(args.time || '').trim();\nconst m = time.match(/^(\\d{1,2}):(\\d{2})\\s*(am|pm)?/i);\nif (m) {\n  let h = parseInt(m[1], 10);\n  if (m[3] && m[3].toLowerCase() === 'pm' && h < 12) h += 12;\n  if (m[3] && m[3].toLowerCase() === 'am' && h === 12) h = 0;\n  time = String(h).padStart(2, '0') + ':' + m[2];\n}\nconst d = new Date(`${date}T${time}:00+05:30`);\nif (isNaN(d.getTime())) throw new Error('Bad date/time: ' + JSON.stringify(args));\n\nreturn [{ json: {\n  toolCallId: call ? call.id : 'test',\n  phone: String(args.phone || '').trim(),\n  date, time,\n  start: d.toISOString()\n}}];"
      },
