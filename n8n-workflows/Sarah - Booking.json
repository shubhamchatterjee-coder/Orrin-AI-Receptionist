    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || {};\nconst msg = body.message || {};\nconst call = (msg.toolCallList && msg.toolCallList[0])\n  || (msg.toolCalls && msg.toolCalls[0])\n  || (msg.toolWithToolCallList && msg.toolWithToolCallList[0] && msg.toolWithToolCallList[0].toolCall)\n  || null;\n\nlet args;\nif (call) {\n  args = call.arguments || (call.function && call.function.arguments) || {};\n  if (typeof args === 'string') args = JSON.parse(args);\n} else {\n  args = body; // Vapi test button sends the fields directly\n}\n\nconst date = String(args.date || '').trim();\nlet time = String(args.time || '').trim();\nconst m = time.match(/^(\\d{1,2}):(\\d{2})\\s*(am|pm)?/i);\nif (m) {\n  let h = parseInt(m[1], 10);\n  if (m[3] && m[3].toLowerCase() === 'pm' && h < 12) h += 12;\n  if (m[3] && m[3].toLowerCase() === 'am' && h === 12) h = 0;\n  time = String(h).padStart(2, '0') + ':' + m[2];\n}\n\nconst d = new Date(`${date}T${time}:00+05:30`);\nif (isNaN(d.getTime())) {\n  throw new Error('Bad date/time. Got args: ' + JSON.stringify(args));\n}\n\nreturn [{ json: {\n  toolCallId: call ? call.id : 'test',\n  name: args.name,\n  phone: args.phone,\n  service: args.service,\n  date,\n  time,\n  start: d.toISOString()\n}}];"
